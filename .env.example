DATABASE_URL=postgresql://verzel:verzel_dev@localhost:5432/verzel_auction
TEST_DATABASE_URL=postgresql://verzel:verzel_dev@localhost:5432/verzel_auction_test

PORT=3000
# Generate a random secret with at least 32 bytes before starting the API.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
DUMMYJSON_TIMEOUT_MS=5000

# Optional independent witness. Leave all unset to report VERIFICATION_UNAVAILABLE.
# The API receives only a PUBLIC key; the witness private key stays in its own service.
# AUDIT_WITNESS_URL=http://127.0.0.1:8081
# AUDIT_WITNESS_NAMESPACE=verzel-local
# AUDIT_WITNESS_PUBLIC_KEY_FILE=/secure/public.pem
# AUDIT_WITNESS_PUBLISH_TOKEN=<random-token-at-least-16-characters>
# AUDIT_WITNESS_TIMEOUT_MS=5000
# AUDIT_ANCHOR_POLL_MS=5000

# Demonstration accounts only. Required by db:seed; minimum 12 characters.
SEED_AUCTIONEER_PASSWORD=AuctioneerDemo2026!
SEED_BIDDER1_PASSWORD=BidderOneDemo2026!
SEED_BIDDER2_PASSWORD=BidderTwoDemo2026!
