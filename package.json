    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "drizzle-orm": "^1.0.0-rc.5",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
