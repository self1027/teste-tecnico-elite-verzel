{
  "type": "module",
  "scripts": {
    "build": "npx tsc",
    "start": "npx nodemon dist/server.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "node --import tsx --test tests/*.test.js",
